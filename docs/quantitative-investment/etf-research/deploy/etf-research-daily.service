[Unit]
Description=ETF research daily admission and report pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/etf-research-git-snapshot/docs/quantitative-investment/etf-research
ExecStart=%h/projects/etf-research-py312/bin/python scripts/run_daily.py
Environment=PYTHONUTF8=1
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=15min
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes

# User unit, supplied for review/validation. No notification or Git credentials.
