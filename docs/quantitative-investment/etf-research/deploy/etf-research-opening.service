[Unit]
Description=Capture independent ETF opening auction evidence

[Service]
Type=oneshot
WorkingDirectory=%h/projects/etf-research-observation
ExecStart=%h/projects/etf-research-py312/bin/python scripts/observe_opening_quotes.py --run --archive-store %h/projects/etf-research-observation-archive
Environment=PYTHONPATH=src
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=80s
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0022
