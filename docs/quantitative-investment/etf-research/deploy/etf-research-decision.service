[Unit]
Description=Freeze independent ETF research inputs before the decision deadline

[Service]
Type=oneshot
WorkingDirectory=%h/projects/etf-research-observation
ExecStart=%h/projects/etf-research-py312/bin/python scripts/seal_observation_decision.py --run --price-project %h/projects/etf-research-git-snapshot/docs/quantitative-investment/etf-research --archive-store %h/projects/etf-research-observation-archive
Environment=PYTHONPATH=src
Environment=PYTHONUTF8=1
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=5min
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0022
