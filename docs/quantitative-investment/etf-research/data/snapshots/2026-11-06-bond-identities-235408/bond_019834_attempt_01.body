	   <li><script type="text/javascript">
	var sug = {};
	var globalSch = function(){
		var bondCode = $("#searchCode").val();
		var result = getAllBonds();
		var codeRule = /^\d{6}$/;    // 六位数字
		var zyhgCode = /^204\d{3}$/; // 204开头六位数字
	    if(codeRule.test(bondCode)){
	        if(result[bondCode] == null || result[bondCode] == undefined){
				window.open("/data/quote/indexb.shtml?BONDCODE=" + bondCode , "_blank"); // 竞价行情
			}else if(zyhgCode.test(bondCode)){
				window.open("/data/quote/indexc.shtml?BONDCODE=" + bondCode , "_blank"); // 质押式回购行情
			}else{
				window.open("/disclosure/info/index.shtml?BONDCODE=" + bondCode , "_blank"); // 债券基本要素
			}
	    }else{
	    	alert("请输入正确的证券代码或简称");
	    }
	}
	var blurFunc = function(){
		var value = $("#searchCode").val();
		if (value ==''){value='搜索'};
		clearSuggest();
	}
</script>
