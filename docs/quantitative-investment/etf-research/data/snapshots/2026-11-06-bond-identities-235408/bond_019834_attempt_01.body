<script type="text/javascript">
var windwoS = window.screen.width;//屏幕分辨率宽度

if(windwoS < 769 || windwoS == 1080){
    /* ========== 一级菜单 ========== */
    document.write("<div class='container demo-3'><div class='main clearfix'><div class='column'><div id='dl-menu' class='dl-menuwrapper'><button>Open Menu</button><ul class='dl-menu'>"); //输出html内容
    var arrayName = "MapMenu_00"; //声明变量：数组名称（字符串）
    var arrayData = eval(arrayName); //将字符串转为数据：数组
    for (i = 0; i < arrayData.length; i++) { //循环：输出各一级导航
        document.write("<li><a href=" + arrayData[i][4] + ">" + arrayData[i][0] + "</a>"); //输出html内容：数组栏目名
          var hasChild = arrayData[i][3]; //声明变量：是否有子导航
          if(arrayData[i][4] == "/home/"){
              hasChild = 0;
          }
          if (hasChild != 0) { //如果有子导航
            /* ========== 二级菜单 ========== */
            document.write("<ul class='dl-submenu'><li class='dl-back'><a href='#'>返回</a></li><li><a href=" + arrayData[i][4] + ">" + arrayData[i][0] + "</a></li>"); //输出html内容
              var arrayName1 = "MapMenu_" + arrayData[i][1]; //声明变量：获取二级导航名称 
              var arrayData1 = eval(arrayName1);
              for (j = 0; j < arrayData1.length; j++) {
                document.write("<li><a href=" + arrayData1[j][4] + ">" + arrayData1[j][0] + "</a>");
                var hasChild1 = arrayData1[j][3]; //声明变量：是否有子导航
                var arrayHref = arrayData1[j][4];
                var flag = (arrayHref.indexOf('disclosure/ppb') != -1 || arrayHref.indexOf('techrules') != -1 || arrayHref.indexOf('fees') != -1 || arrayHref.indexOf('eligibility') != -1);
                  if(flag){
                    document.write("<ul class='dl-submenu'><li class='dl-back'><a href='#'>返回</a></li><li><a href=" + arrayData1[j][4] + ">" + arrayData1[j][0] + "</a></li></ul>");
                  }
                  if (hasChild1 != 0) {
                      /* ========== 三级菜单 ========== */
                      // document.write("<ul class='dl-submenu'><li class='dl-back'><a href='#'>返回</a></li><li><a href=" + arrayData1[j][4] + ">" + arrayData1[j][0] + "</a></li>");
                      document.write("<ul class='dl-submenu'><li class='dl-back'><a href='#'>返回</a></li>"); 
                      var arrayName2 = "MapMenu_" + arrayData1[j][1];
                      var arrayData2 = eval(arrayName2);
                      for (k = 0; k < arrayData2.length; k++) {
                          document.write("<li><a href=" + arrayData2[k][4] + ">" + arrayData2[k][0]  + "</a>"); //输出html内容
                          var hasChild2 = arrayData2[k][3]; //声明变量：是否有子导航
                          if(hasChild2 != 0){
                            /* ========== 四级菜单 ========== */
                            document.write("<ul class='dl-submenu'><li class='dl-back'><a href='#'>返回</a></li>");
                            var arrayName3 = "MapMenu_" + arrayData2[k][1];
                              var arrayData3 = eval(arrayName3);
                              for(m = 0; m < arrayData3.length; m++){
                                  document.write("<li><a href=" + arrayData3[m][4] + ">" + arrayData3[m][0] + "</a></li>");
                              }
                            document.write("</ul>"); //输出html内容
                          }
                          document.write("</li>"); //输出html内容
                        }
                      document.write("</ul>"); //输出html内容
                    }
                document.write("</li>"); //输出html内容
              }
              document.write("</ul>"); //输出html内容
          }

        document.write("</li>"); //输出html内容
    }
    document.write("</ul></div></div></div></div>"); //输出html内容
}else{
    document.write("<div class='top_right_menu'><ul class='clearfix'>"); //输出html内容
    var arrayName = "MMenu_00"; //声明变量：数组名称（字符串）
    var arrayData = eval(arrayName); //将字符串转为数据：数组
    for(i=0;i<arrayData.length;i++){ //循环：输出各一级导航
      document.write('<li><a href="'+arrayData[i][4]+'" ' + (arrayData[i][5] == '1' ? 'target="_blank"' : '') +'>'+arrayData[i][0]+'</a>'); //输出html内容：数组栏目名

      /* ========== 下拉子菜单 ========== */
      var arrayData0 = arrayData[i][3]; //声明变量：是否有子导航
      if(arrayData0!=0){ //如果有子导航
          document.write("<div class='sub_menu clearfix' style='display: none;'>"); //输出html内容

          var arrayName1 = "MMenu_"+arrayData[i][1]; //声明变量：获取二级导航名称
          var arrayData1 = eval(arrayName1);
          for(j=0;j<arrayData1.length;j++){
            document.write('<dl><dt><a href="'+arrayData1[j][4]+'" ' + (arrayData1[j][5] == '1' ? 'target="_blank"' : '') +'>'+arrayData1[j][0]+'</a></dt>');

            /* ========== 三级菜单 ========== */
            var arrayData2 = arrayData1[j][3]; //声明变量：是否有子导航
            if(arrayData2!=0){
                var arrayName3 = "MMenu_"+arrayData1[j][1];
                var arrayData3 = eval(arrayName3);
                for(k=0;k<arrayData3.length;k++){
                    document.write('<dd><a href="'+arrayData3[k][4]+'" ' + (arrayData3[k][5] == '1' ? 'target="_blank"' : '') +'>'+arrayData3[k][0]+'</a></dd>');
                }
            }
            /* ========== 三级菜单 ========== */

            document.write("</dl>");
            }

          document.write("</div>"); //输出html内容
        }
      /* ========== 下拉子菜单 ==========*/

      document.write("</li>"); //输出html内容
    }
    document.write("</ul></div>"); //输出html内容
}

