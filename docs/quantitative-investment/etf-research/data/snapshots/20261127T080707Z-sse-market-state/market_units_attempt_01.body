        } else if (data[k].PRODUCT_NAME == '信用债') {
          table7 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table7 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table7 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table7 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '基金') {
          table8 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table8 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table8 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table8 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == 'ETF') {
          table9 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table9 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table9 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table9 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == 'LOF') {
          table10 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table10 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table10 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table10 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '公募REITs') {
          table11 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table11 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table11 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table11 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '期权') {
          table12 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table12 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table12 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table12 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '回购') {
          table13 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table13 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table13 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table13 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '其他') {
          table14 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table14 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table14 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table14 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        }
      }
    }
    activityStarHtml += '<tr><td>股票</td>';
    activityStarHtml += (table0 == '' ? emptyTr : table0);
    activityStarHtml += '<tr><td ' + tdTitle_style + '>&emsp;&emsp;主板A</td>';
    activityStarHtml += (table1 == '' ? emptyTr : table1);
    activityStarHtml += '<tr><td ' + tdTitle_style + '>&emsp;&emsp;主板B</td>';
    activityStarHtml += (table2 == '' ? emptyTr : table2);
    activityStarHtml += '<tr><td ' + tdTitle_style + '>&emsp;&emsp;科创板</td>';
    activityStarHtml += (table3 == '' ? emptyTr : table3);
    activityStarHtml += '<tr><td>优先股</td>';
    activityStarHtml += (table4 == '' ? emptyTr : table4);
    activityStarHtml += '<tr><td>债券</td>';
    activityStarHtml += (table5 == '' ? emptyTr : table5);
    activityStarHtml += '<tr><td ' + tdTitle_style + '>&emsp;&emsp;政府债</td>';
    activityStarHtml += (table6 == '' ? emptyTr : table6);
    activityStarHtml += '<tr><td ' + tdTitle_style + '>&emsp;&emsp;信用债</td>';
    activityStarHtml += (table7 == '' ? emptyTr : table7);
    activityStarHtml += '<tr><td>基金</td>';
    activityStarHtml += (table8 == '' ? emptyTr : table8);
    activityStarHtml += '<tr><td ' + tdTitle_style + '>&emsp;&emsp;ETF</td>';
    activityStarHtml += (table9 == '' ? emptyTr : table9);
    activityStarHtml += '<tr><td ' + tdTitle_style + '>&emsp;&emsp;LOF</td>';
    activityStarHtml += (table10 == '' ? emptyTr : table10);
    activityStarHtml += '<tr><td ' + tdTitle_style + '>&emsp;&emsp;公募REITs</td>';
    activityStarHtml += (table11 == '' ? emptyTr : table11);
    activityStarHtml += '<tr><td>期权</td>';
    activityStarHtml += (table12 == '' ? emptyTr : table12);
    activityStarHtml += '<tr><td>回购</td>';
    activityStarHtml += (table13 == '' ? emptyTr : table13);
    // 11-27 之前无其他
    if(data[0].TRADE_DATE && (new Date(turnDateAddLine(data[0].TRADE_DATE))  > new Date('2023-11-26'))){
      activityStarHtml += '<tr><td>其他</td>';
      activityStarHtml += (table14 == '' ? emptyTr : table14);
    }
    activityStarHtml += "</tbody>";
    $(".js_marketGeneralPicture .table").html(activityStarHtml);
  },
  /**
   * 数值处理方法 保留两位小数
   * @param {*} num 需要处理的数据
   * @returns 
   */
  numberDispose(num) {
    num = String(num);
    if (num == "-" || num == null || num == "undefined" || num == "") {
      num = "-";
      return num;
    } else if (num == 0) {
      return num;
    }
    // 如果没有找到匹配的字符串则返回 -1。
    if (num.indexOf(".") != -1) {
      var newArray1 = num.split(".");
      if (newArray1[1].length < 2) {
        return num += '0';
      } else {
        return num;
      }
    } else {
      return num += '.00';
    }
  }
}

if ($(".js_marketGeneralPicture").length > 0) {
  marketGeneralPicture.init();
}

