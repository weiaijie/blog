
/**
 * 市场概貌-start
 */

var marketGeneralPicture = {
  activityStarUrl: sseQueryURL + 'commonQuery.do',
  activityStarParams: {
    isPagination: false,
    sqlId: "COMMON_SSE_SJ_SCGM_C",//官网-数据-市场概貌
    TRADE_DATE: '',//查询日期
  },
  init: function () {
    var _this = this;
    _this.loadEvents();
    _this.getactivityStarList();
  },
  loadEvents: function () {
    var _this = this;
    var min_y = 2022 + '-09-05';
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      format: "yyyy-MM-dd",
      isInitValue: false,
      min: min_y,
      trigger: "click",
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setactivityStarParams();
        }, 500);
      },
    });
  },
  setactivityStarParams: function () {
    var _this = marketGeneralPicture;
    _this.activityStarParams.TRADE_DATE = $(".js_date input").val();
    _this.getactivityStarList();
  },
  getactivityStarList: function (funcname) {
    var _this = marketGeneralPicture;
    var emptyTr = '<tr><td colspan="5">暂无数据</td></tr>';
    var activityStarHtml = "<thead><tr>";
    activityStarHtml += '<th >分类</th>';
    activityStarHtml += '<th class="text-right">数量(只)</th>';
    activityStarHtml += '<th class="text-right">总市值(亿元)</th>';
    activityStarHtml += '<th class="text-right">流通市值(亿元)</th>';
    activityStarHtml += '<th class="text-right">成交额(亿元)</th>';
    activityStarHtml += "</tr></thead><tbody>";
    var downUrl = sseQueryURL + "commonExcelDd.do?sqlId=COMMON_SSE_SJ_SCGM_C&isPagination=false" + "&TRADE_DATE=" + _this.activityStarParams.TRADE_DATE;
    var downHtm = '<a class="tableDownload js_download_market" href="' + downUrl + '">' + "下载</a>";
    if ($('.js_download_market').length > 0) {
      $('.js_download_market').attr('href', downUrl);
    } else {
      $(".title_lev2 .new_date").after(downHtm);
    }
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.activityStarUrl,
      data: _this.activityStarParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $(".js_marketGeneralPicture .new_date").html(
            "数据日期：" + turnDateAddLine(data.result[0].TRADE_DATE)
          );
          if (!isNull($(".js_date input").val())) {
            $(".js_date input").val(turnDateAddLine(data.result[0].TRADE_DATE));
          }
          _this.tableContenHtml(data.result);
        } else {
          if (isNull($(".js_date input").val())) {
            $(".js_marketGeneralPicture .new_date").html(
              "数据日期：" + $(".js_date input").val()
            );
          } else {
            $(".js_marketGeneralPicture .new_date").html('');
          }
          $(".js_marketGeneralPicture .table").html(activityStarHtml + emptyTr);
        }
      },
      errCallback: function () {
        if (isNull($(".js_date input").val())) {
          $(".js_marketGeneralPicture .new_date").html(
            "数据日期：" + $(".js_date input").val()
          );
        } else {
          $(".js_marketGeneralPicture .new_date").html('');
        }
        $(".js_marketGeneralPicture .table").html(activityStarHtml + emptyTr);
      },
    });
  },
  /**
   * 可以操作数据更简便些
   * -----*_*  *_*
   * @param {*} data 
   */
  tableContenHtml(data) {
    var _this = marketGeneralPicture;
    var tdTitle_style = "style='white-space: nowrap;'"
    var emptyTr = '';
    var activityStarHtml = "<thead><tr>";
    activityStarHtml += '<th >分类</th>';
    activityStarHtml += '<th class="text-right">数量(只)</th>';
    activityStarHtml += '<th class="text-right">总市值(亿元)</th>';
    activityStarHtml += '<th class="text-right">流通市值(亿元)</th>';
    activityStarHtml += '<th class="text-right">成交额(亿元)</th>';
    activityStarHtml += "</tr></thead><tbody>";
    for (var i = 0; i < 15; i++) {
      var table = 'table' + i;
      window[table] = '';
    }
    for (var j = 0; j < 4; j++) {
      emptyTr += '<td class="text-right">-</td>';
    }
    if (isNull(data)) {
      for (var k = 0; k < data.length; k++) {
        if (data[k].PRODUCT_NAME == '股票') {
          table0 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table0 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table0 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table0 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '主板A') {
          table1 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table1 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table1 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table1 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '主板B') {
          table2 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table2 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table2 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table2 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '科创板') {
          table3 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table3 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table3 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table3 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '优先股') {
          table4 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table4 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table4 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table4 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '债券') {
          table5 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table5 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table5 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
          table5 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_TRADE_AMT) + '</td>';
        } else if (data[k].PRODUCT_NAME == '政府债') {
          table6 += '<td class="text-right">' + data[k].SECURITY_NUM + '</td>';
          table6 += '<td class="text-right">' + _this.numberDispose(data[k].TOTAL_VALUE) + '</td>';
          table6 += '<td class="text-right">' + _this.numberDispose(data[k].NEGO_VALUE) + '</td>';
