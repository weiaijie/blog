<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=7" />
    <meta http-equiv="pragma" content="no-cache">
    <meta http-equiv="cache-control" content="no-cache,no-store">
    <meta http-equiv="expires" content="0"/>
    <title>业绩 - 国泰基金管理有限公司</title>
  	<meta http-equiv="keywords" content="泰有财 - 国泰基金"/>
	<meta http-equiv="description" content=""/>
    <link href="/css/brandstyle.css" rel="stylesheet" type="text/css" />
    <script type="text/javascript" src="/js/jquery.min.js"></script>
    <script language="javascript" type="text/javascript" src="/js/My97DatePicker/WdatePicker.js"></script>
    <script src="/js/jquery.SuperSlide.2.1.1.js" type="text/javascript"></script>
    <script type="text/javascript">
        document.write('<script type="text/javascript" src="/common/index.html.js?'+new Date().getTime()+'"><\/script>');
    </script>
</head>
<body>
<table width="100%" border="0" cellspacing="0" cellpadding="0" class="tab4"><tbody>
    <tr>
        <th>单位净值</th><td id="fund_todaynetvalue"><script>$("#fund_todaynetvalue").html(zhishu._511010.todaynetvalue)</script></td>
        <th>日增长率</th><td id="fund_dayinc"><script>$("#fund_dayinc").html(zhishu._511010.dayinc)</script></td>
    </tr>
    <tr>
        <th>累计净值</th><td id="fund_todaytotalnetvalue"><script>$("#fund_todaytotalnetvalue").html(zhishu._511010.todaytotalnetvalue)</script></td>
        <th>今年以来增长率</th><td id="fund_yearinc"><script>$("#fund_yearinc").html(zhishu._511010.yearinc)</script></td>
    </tr>
</tbody></table>
<div class="yjzst" style="padding: 20px;width: 650px;">
    <div class="yjst_hd">
        <ul><li class="on">业绩走势图</li><li>净值查询</li></ul>
    </div>
    <div class="yjst_bd">
        <div class="yjst_con">
            <iframe src="/webapps/products/products-yeji?fundcode=511010" scrolling="no" frameborder="0" height="430" width="650" style="background-color: #fff;"></iframe>
        </div>
        <div class="yjst_con">
            <iframe id="frmFlash" src="" scrolling="no" frameborder="0" height="360" width="650" style="background-color: #fff;"></iframe>
            <script type="text/javascript">
                var frmChartSrc = "/chart-web/chart/fundnetchart?width=630&height=350&fundcode=511010";//参数titleflag=1表示显示flash里的基金名称
                var frmTableSrc = "/chart-web/chart/fundnettable?pages=1-15&fundcode=511010";
                function LoadHistory(){
                    var CalendarStart = document.getElementById("sDate1");
                    var CalendarEnd = document.getElementById("sDate2");
                    var startDate = new Date(CalendarStart.value.replace(/-/g, "/"));
                    var endDate = new Date(CalendarEnd.value.replace(/-/g, "/"));
                    if (startDate > endDate){
                        alert("查询起始日期需小于结束日期！");
                        return false;
                    }
                    var sDate1 = CalendarStart.value;
                    var sDate2 = CalendarEnd.value;
                    LoadNetValueList(sDate1, sDate2);
                }

                function LoadNetValueList(sDate1, sDate2){
                    var chart = document.getElementById("frmFlash");
                    chart.src = frmChartSrc + "&from=" + sDate1 + "&to=" + sDate2;
                    var frm = document.getElementById("frmTable");
                    frm.src = frmTableSrc + "&from=" + sDate1 + "&to=" + sDate2;
                }

                function shijian(time){
                    var oldDate = new Date();
                    var currDate = new Date();
                    var months = "01";//月
                    var days = "01";//天
                    if(time==0 && $("#chengli")){//成立以来
                        oldDate = document.getElementById("chengli").value;
                    }else if (time==1){//今年以来
                        oldDate = currDate.getFullYear()+"-01-01";
                    }else{
                        oldDate.setTime(currDate.getTime()-time*24*3600*1000);
                        months = oldDate.getMonth()+1;
                        days = oldDate.getDate();
                        if(months < 10){months = "0" + months;}
                        if(days < 10){days = "0" + days;}
                        oldDate = oldDate.getFullYear() + "-" + months + "-" + days;
                    }
                    months = currDate.getMonth()+1;
                    days = currDate.getDate();
                    if(months < 10){months = "0" + months;}
                    if(days < 10){days = "0" + days;}
                    currDate = currDate.getFullYear() + "-" + months + "-" + days;
                    document.getElementById("sDate1").value = oldDate;
                    document.getElementById("sDate2").value = currDate;
                    LoadNetValueList(oldDate,currDate);
                }
            </script>
            <table cellpadding="0" cellspacing="0" width="100%" style="margin: 10px">
                <tr>
                    <td>请选择时间段：</td>
                    <td valign="top">
                        <select name="shijian" id="shijian" onchange="shijian(this.value)">
                            <option value="365">最近一年</option>
                            <option value="90">最近三月</option>
                            <option value="180">最近半年</option>
                            <option value="1">今年以来</option>
                        </select>
                                <script>
                                    var mySelect = document.getElementById("shijian");
                                    var opp = new Option("成立以来","0");
                                    mySelect.add(opp);
                                </script>
                                <input type="hidden" name="chengli" id="chengli" value="2013-03-06"/>
                    </td>
                    <td align="center" width="40">|</td>
                    <td>起始日期</td>
                    <td valign="top"><input style="width: 90px;" type="text" id="sDate1" onfocus="WdatePicker({maxDate:'#F{$dp.$D(\'sDate2\')||\'%y-%M-%d\'}'})"/></td>
                    <td>终止日期</td>
                    <td valign="top"><input style="width: 90px;" type="text" id="sDate2" onfocus="WdatePicker({minDate:'#F{$dp.$D(\'sDate1\')}',maxDate:'%y-%M-%d'})"></td>
                    <td valign="top"><a onclick="LoadHistory()" style="width: 60px;cursor: pointer;"> 查询 </a></td>
                </tr>
            </table>
            <iframe id="frmTable" src="" scrolling="no" frameborder="0" height="550" width="650" style="background-color: #fff;"></iframe>
            <script type="text/javascript">
                shijian(365);//调用最近一年净值
                $(".yjzst").slide({titCell:".yjst_hd li",mainCell:".yjst_bd", trigger:"click"});
            </script>
        </div>
    </div>
</div>
</body>
</html>