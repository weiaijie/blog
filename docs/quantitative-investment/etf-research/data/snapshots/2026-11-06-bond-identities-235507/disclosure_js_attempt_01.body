    var snapAjax = function (url, pas, func) {
      if (hCodes == undefined || hCodes == null || hCodes.length == 0) {
        filling([]);
        return;
      }
      $.ajax({
        type: "POST",
        url: url + hCodes,
        data: pas,
        dataType: "jsonp",
        jsonp: "callback",
        jsonpCallback: "callback" + Math.floor(Math.random() * (100000 + 1)),
        timeout: 30000,
        contentType: "application/json; charset=utf-8",
        success: function (result) {
          if ($.isEmptyObject(result)) {
            result = {};
          }
          if ($.isEmptyObject(result.snap)) {
            result.snap = [];
          }
          result.snap.push(result.time);
          func(result.snap);
        },
        error: function (jqXHR, textStatus, errorThrown) {
          if (
            jqXHR.status === 0 ||
            jqXHR.status === 400 ||
            jqXHR.status === 404
          ) {
            func([]);
            return;
          }
        },
      });
    };

