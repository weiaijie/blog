      $("#bondlistT").empty();
      bondlistT.init(headers);
      bondlistT.getDataByAjax(url, utils.mergeJson(params, p), null, true);
    };
    // 进入请求
    var defaultRequest = function (p) {
      $("#bondlistT").empty();
      bondlistT.init(headers);
      params.BOND_TYPE = "分离交易的可转换公司债券";
      var Data1 = bondlistT.getDataByAjax(
        url,
        utils.mergeJson(params, p),
        bondlistT,
        true
      );
      setTimeout(function () {
        var res = Data1.data;
        if (res.result && res.result.length > 0) {
          if (res.result[0].TRADE_DATE) {
            ransactionDate = dateReplace(res.result[0].TRADE_DATE);
          } else {
            ransactionDate = "-";
          }
          if (
            ransactionDate != null &&
            ransactionDate != undefined &&
            ransactionDate.length > 0
          )
            $("#updateDate").text("日期：" + ransactionDate + "|");
        }
      }, 500);
    };
