    oneBond.dateFormatter = function (d) {
      var ds = jQuery.trim(d).replace(" ", ":").replace(/\:/g, "-").split("-");
      if (ds[1].length == 1) {
        ds[1] = "0" + ds[1];
      }
      if (ds[2].length == 1) {
        ds[2] = "0" + ds[2];
      }
      return ds[0] + "-" + ds[1] + "-" + ds[2];
    };

    oneBond.titleLen = 220;
    oneBond.subTitle = function (title) {
      oneBond.subTitles = "";
      oneBond.count = 0;
      for (
        var i = 0;
        oneBond.count < oneBond.titleLen && i < title.length;
        i++
      ) {
        var single = title.charCodeAt(i);
        if (
          !(single >= 0x0001 && single <= 0x007e) &&
          !(0xff60 <= single && single <= 0xff9f)
        ) {
          oneBond.count += 8;
        } else {
          oneBond.count += 5;
        }

        if (oneBond.count >= oneBond.titleLen) {
          oneBond.subTitles += "...";
          break;
        }
        oneBond.subTitles += String.fromCharCode(single);
      }

      return oneBond.subTitles;
    };
    var openerURLs = {};
    oneBond.openNewHtml = function (urls, title) {
      window.open(
        "/disclosure/announ/s_announ_content.shtml?content=" +
        utils.decToHex(urls),
        "_blank"
      );
    };
    oneBond.links1 = function (data) {
      var suffixex =
        data.url.indexOf("://") > -1
          ? data.url.indexOf("/", 8)
          : data.url.indexOf("/"); // 截取前缀
      var exUrl = suffixex == 0 ? data.url : data.url.substr(suffixex); // 截取后地址
      var bulletinUrl = staticBondUrl + exUrl;
      if (bulletinUrl.match(/.*?\.(s)?htm(l)?/gi)) {
        bulletinUrl = siteUrl + exUrl;
      }
      return (
        "<span style='float:right;'>" +
        oneBond.dateFormatter(data.sseDate) +
        "</span><a target='_blank' href='" +
        bulletinUrl +
        "' title = '" +
        data.title +
        "'>" +
        oneBond.subTitle(data.title) +
        "</a>"
      );
