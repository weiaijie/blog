require(["/xhtml/js/common.js", "/xhtml/js/bondConfig.js"], function () {
  if ($(".page_content .js_insertJzsgz").length > 0) {
    //记账式国债
    var url = destinationHostURI + "/sseQuery/commonSoaQuery.do?jsonCallBack=?"; //action地址
    var bondlistT = new wideContainer(
      true,
      "bondlistT",
      "basic_data_container",
      "bond_details_table_over",
      "extendZQ"
    ); //参数分别为isPagination、targetDivId、tableId、表格外框样式、表格扩展样式
    var params = {
      isPagination: true,
      sqlId: "CP_ZQ_ZQLB",
      "pageHelp.pageSize": 20,
      BOND_TYPE: "记账式国债",
      BOND_CODE: "",
    }; //传递到后台参数

    var ransactionDate = "-"; //交易日期

    var contentLink = function (data) {
      return (
        "<a target='_blank'  href='/disclosure/info/index.shtml?BONDCODE=" +
        data.BOND_CODE +
        "'>" +
        data.BOND_CODE +
        "</a>"
      );
    };

    var contentForm = function (data) {
      if (data.IS_NOT_DB == "N") {
        return "否";
      } else if (data.IS_NOT_DB == "Y") {
        return "是";
      } else {
        return data.IS_NOT_DB;
      }
    };

    var headers = new Array();

    headers[0] = {
      headName: "序号",
      code: "NUM",
    };
    headers[1] = {
      headName: "债券代码",
      code: "BOND_CODE",
      formatter: contentLink,
    };
    headers[2] = {
      headName: "债券简称",
      code: "BOND_ABBR",
    };
    headers[3] = {
      headName: "债券扩位简称",
      code: "SECURITY_ABBR_FULL",
    };
    headers[4] = {
      headName: "债券全称",
      code: "BOND_FULL",
    };
    headers[5] = {
      headName: "期限(年)",
      code: "TERM_YEAR",
      className: "td_content_right",
    };
    headers[6] = {
      headName: "计息方式",
      code: "INTEREST_TYPE",
    };
    headers[7] = {
      headName: "付息方式",
      code: "PAY_TYPE",
    };
    headers[8] = {
      headName: "发行量(亿元)",
      code: "ISSUE_VALUE",
      className: "td_content_right",
    };
    headers[9] = {
      headName: "上市日期",
      code: "LISTING_DATE",
    };
    headers[10] = {
      headName: "发行起始日",
      code: "ONLINE_START_DATE_CVS",
    };
    headers[11] = {
      headName: "发行终止日",
      code: "ONLINE_END_DATE_CVS",
    };
    headers[12] = {
      headName: "到期日",
      code: "END_DATE",
    };
    headers[13] = {
      headName: "是否非担保",
      code: "IS_NOT_DB",
      formatter: contentForm,
    };
    var doDynamicRequest = function (p) {
      $("#bondlistT").empty();
      bondlistT.init(headers);
      bondlistT.getDataByAjax(url, utils.mergeJson(params, p), null, true);
    };

    var defaultRequest = function (p) {
      $("#bondlistT").empty();
      bondlistT.init(headers);
      var Data1 = bondlistT.getDataByAjax(
        url,
        utils.mergeJson(params, p),
        bondlistT,
        true
      );
      setTimeout(function () {
        var res = Data1.data;
        if (res.result && res.result.length > 0) {
          if (res.result[0].TRADE_DATE) {
            ransactionDate = dateReplace(res.result[0].TRADE_DATE);
          } else {
            ransactionDate = "-";
          }
          if (
            ransactionDate != null &&
            ransactionDate != undefined &&
            ransactionDate.length > 0
          )
            $("#updateDate").text("日期：" + ransactionDate + "|");
        }
      }, 500);
    };
    var goSwitch = function (event) {
      var eventTarget;
      if (/msie/.test(navigator.userAgent.toLowerCase())) {
        eventTarget = event.srcElement;
      } else if (/firefox/.test(navigator.userAgent.toLowerCase())) {
        eventTarget = event.target;
      }
      var keyword = $("#keywordsearch").val();

      if (
        keyword == "输入债券代码/简称" ||
        keyword == null ||
        keyword == undefined ||
        keyword == ""
      ) {
        alert("请输入债券代码或简称！");
        return false;
      }
      $("#bondlistT").empty();

      var p = {
        BOND_CODE: keyword,
      };

      bondlistT.init(headers);
      downloadParams = utils.mergeJson(params, p);
      bondlistT.getDataByAjax(url, utils.mergeJson(params, p), null, true);
    };

    var downloadParams = params;
    var download = function () {
      var ddUrl =
        destinationHostURI +
        "/commonExcelDd.do?" +
        "sqlId=COMMON_SSE_CP_ZQ_ZQLB_JBXX_C" +
        "&BOND_CODE=" +
        downloadParams.BOND_CODE +
        "&BOND_TYPE=" +
        downloadParams.BOND_TYPE +
        "&display=1" +
        "&" +
        Math.floor(Math.random() * (100000000 + 1));
      window.location.href = ddUrl;
    };

    $(document).ready(function () {
      $("tr").attr("bgColor", "white");
      $("tr:even").css("background-color", "#f9f9f9");
      utils.dynamicRequest({
        element: document.getElementById("staticPagination"),
        method: doDynamicRequest,
      }); //分页相关 (必须)
      var total = 886;
      if (total == null || total == undefined) {
        total = 0;
      }
      utils.compositeInfo({
        info: "总共" + total + "条数据",
        target: "deadling",
      }); //表格右上角显示信息（总共134条, 现在显示1到30条）(必须)
      utils.dynamicCompositeInfo(bondlistT, {
        target: "deadling",
      }); //表格右上角显示信息（总共134条, 现在显示1到30条）(必须)
      //发送请求
      defaultRequest();
      $(".search-btn").click(function () {
        goSwitch();
      });
      $(".download-btn").click(function () {
        download();
      });
    });
  }

  if ($(".page_content .js_insertDfzfzq").length > 0) {
