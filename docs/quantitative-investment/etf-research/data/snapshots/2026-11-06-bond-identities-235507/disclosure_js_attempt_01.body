      formatter: contentLink,
    };
    headers[2] = {
      headName: "债券简称",
      code: "BOND_ABBR",
    };
    headers[3] = {
      headName: "债券扩位简称",
      code: "SECURITY_ABBR_FULL",
    };
    headers[4] = {
      headName: "债券全称",
      code: "BOND_FULL",
    };
    headers[5] = {
      headName: "期限(年)",
      code: "TERM_YEAR",
      className: "td_content_right",
    };
    headers[6] = {
      headName: "计息方式",
      code: "INTEREST_TYPE",
    };
    headers[7] = {
      headName: "付息方式",
      code: "PAY_TYPE",
    };
    headers[8] = {
      headName: "发行量(亿元)",
      code: "ISSUE_VALUE",
      className: "td_content_right",
