    var formatter = function (value) {
      if (isNaN(Number(value))) {
        return value;
      }
      return Number(value).toFixed(4);
    };

    var formatter1 = function (value) {
      if (value == "N") {
        return "否";
      } else if (value == "Y") {
        return "是";
      } else {
        return value;
      }
    };
    /*
            @params { args } String 交易方式枚举值如果多个则以逗号分割
            */
    var TradeMethod = function (args) {
      if (!args) {
        return "-";
      }
      return args.split(",").reduce(function (total, item, index, arr) {
        var isSymbol = "";
        if (index != 0) {
          isSymbol = ",";
        }
        if (!item) {
          return total + isSymbol + "-";
        }
        switch (item) {
          case "PPCJ":
            return total + isSymbol + "匹配成交";
          case "DJCJ":
            return total + isSymbol + "点击成交";
          case "XJCJ":
            return total + isSymbol + "询价成交";
          case "JMCJ":
            return total + isSymbol + "竞买成交";
          case "XSCJ":
            return total + isSymbol + "协商成交";
          default:
            return total + isSymbol + item;
        }
      }, "");
    };

