    $(document).ready(function () {
      if (BONDCODE === null || BONDCODE === undefined || BONDCODE === "") {
        defaultSet();
        $("[id='issueDay']").remove();
        $("table.bond_details_table1 tr:even").css(
          "background-color",
          "rgba(240,240,240,0.7)"
        );
      } else {
        var allBonds = getAllBonds();
        var bondType = "";
        if (allBonds[BONDCODE] != null && allBonds[BONDCODE] != undefined) {
          bondType = allBonds[BONDCODE][1];
        }

        var paramsDetail = {
          isPagination: false,
          sqlId: "COMMON_SSEBOND_XXPL_ZQXX_KZHGSZQ_XQ_C",
          BOND_CODE: BONDCODE,
        };
        if (bondType.match(/^((可转)|(分离))+.*?/gi)) {
          $(".bond_details_table1 .add_part").remove();
        }

        if (
          bondType.match(
            /^(次级债|非公开发行|可转换|分离|可交换|公司债|证券公司资产支持|企业债|中小企业|新企业债券)+.*?/gi
          )
        ) {
          $("[id='issueDay']").css("display", "");
        } else {
          $("[id='issueDay']").remove();
        }
        if (bondType == "可转换公司债券") {
          $("[id='FACE_HEAD']").remove();
          $("[id='FACE_RATE']").remove();
          $("[id='TERM_YEAR']").attr("colspan", "3");
          $("[id='LISTING_DATE']").remove();
          $("[id='LISTING_HEAD']").remove();
        }
        $("table.bond_details_table1 tr:even").css(
          "background-color",
          "rgba(240,240,240,0.7)"
        );

        var conversion = function(val){
          if(val == '企业债券' || val == '公司债券' || val == '新企业债券'){
            return '公开发行公司债券（含企业债券）';
          } else if(val == '中小企业私募债券' || val == '非公开发行公司债券'){
            return '非公开发行公司债券（含企业债券）';
          } else {
            return val;
          }
        }

        utils.getJSON(url, paramsDetail, function (data) {
          if (data.result === null || data.result[0] === undefined) {
            defaultSet();
          } else {
            $("[id='BOND_CODE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].BOND_CODE)
              )
            );
            $("[id='BOND_ABBR']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].BOND_ABBR)
              )
            );
            $("[id='ISSUE_OWNER']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].ISSUE_OWNER)
              )
            );
            $("[id='SECURITY_ABBR_FULL']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].SECURITY_ABBR_FULL)
              )
            );
            $("[id='BOND_FULL']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].BOND_FULL)
              )
            );
            $("[id='ISSUE_VALUE']").text(
              checkTradeDate(
                formatter(
                  utils.ifEmptyThenSetToOther(data.result[0].ISSUE_VALUE_HM)
                )
              )
            );
            $("[id='BOND_TYPE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(conversion(data.result[0].BOND_TYPE))//转义
              )
            );
            $("[id='START_DATE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(
                  dateFormat(data.result[0].START_DATE)
                )
              )
            );
            $("[id='END_DATE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(dateFormat(data.result[0].END_DATE))
              )
            );
            $("[id='LISTING_DATE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(
                  dateFormat(data.result[0].LISTING_DATE)
                )
              )
            );
            $("[id='INTEREST_TYPE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].INTEREST_TYPE)
              )
            );
            $("[id='PAY_TYPE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].PAY_TYPE)
              )
            );
            $("[id='FACE_RATE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].FACE_RATE)
              )
            );
            $("[id='TERM_YEAR']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].TERM_YEAR)
              )
            );
            $("[id='RATE']").text(
              checkTradeDate(utils.ifEmptyThenSetToOther(data.result[0].RATE))
            );
            $("[id='CLEAN_PRICE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].CLEAN_PRICE)
              )
            );
            $("[id='SSE_TOTAL_AMT']").text(
              checkTradeDate(
                formatter(
                  utils.ifEmptyThenSetToOther(data.result[0].SSE_TOTAL_AMT)
                )
              )
            );
            $("[id='BANK_CODE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].BANK_CODE)
              )
            );
            $("[id='BASE_RATE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].BASE_RATE)
              )
            );
            $("[id='MANAGE_TYPE']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].MANAGE_TYPE)
              )
            );
            $("[id='TRADE_TYPE']").text(
              checkTradeDate(TradeMethod(data.result[0].TRADE_TYPE))
            );
            $("[id='BOND_RATING']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].BOND_RATING)
              )
            );
            $("[id='MAIN_RATING']").text(
              checkTradeDate(
                utils.ifEmptyThenSetToOther(data.result[0].MAIN_RATING)
              )
            );
            $("[id='IS_NOT_DB']").text(
              checkTradeDate(
                formatter1(
                  utils.ifEmptyThenSetToOther(data.result[0].IS_NOT_DB)
                )
              )
            );

            if (
              bondType.match(
                /^(次级债|非公开发行|可转换|分离|可交换|公司债|证券公司资产支持|企业债|中小企业|新企业债券)+.*?/gi
              )
            ) {
              $("[id='ISSUED_START_DAY']").text(
                utils.ifEmptyThenSetToOther(
                  dateFormat(data.result[0].ONLINE_START_DATE)
                )
              );
              $("[id='ISSUED_END_DAY']").text(
                utils.ifEmptyThenSetToOther(
                  dateFormat(data.result[0].ONLINE_END_DATE)
                )
              );
            }

            if (bondType.match(/^((信贷)|(证券公司)|(企业))资产支持证券/gi)) {
              $("[id='ownerName']").text("原始权益人");
            }

            if (bondType.match(/^((可转)|(分离))+.*?/gi)) {
              $("[id='MANAGE_TYPE']").text("公开发行");
              $("[id='BOND_TYPE']").text(bondType);
            }
          }
        });
      }
      snapAjax(jjUrl, pasJJ, jjFilling);
      snapAjax(bjUrl, pasBJ, bjFilling);
      if (oneBond.bondType.match(/^(可转)+.*?/gi)) {
        oneBond.url = oneBond.url3;
        oneBond.params = oneBond.params2;
        oneBond.headers[0] = {
          code: "",
          formatter: oneBond.links2,
        };
      } else if (oneBond.bondType.match(/^(分离)+.*?/gi)) {
        oneBond.url = oneBond.url2;
        oneBond.params = utils.mergeJson(oneBond.params2, {
          bulletinType: "kfl",
        });
        oneBond.headers[0] = {
          code: "",
          formatter: oneBond.links2,
        };
      } 
      else {
        oneBond.url = oneBond.url1;
        oneBond.params = oneBond.params1;
        oneBond.headers[0] = {
          code: "",
          formatter: oneBond.links1,
        };
      }
      oneBond.doDynamicRequest();
    });
  }
});
