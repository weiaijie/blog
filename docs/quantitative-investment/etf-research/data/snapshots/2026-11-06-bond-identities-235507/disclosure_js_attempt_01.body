  if ($(".page_content .js_insertDetail_new").length > 0) {
    //获取url中的参数方法
    function getUrlParam(name) {
      //构造一个含有目标参数的正则表达式对象
      var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)");
      //匹配目标参数
      var r = window.location.search.substr(1).match(reg);
      //返回参数
      if (r != null) {
        return unescape(r[2]);
      } else {
        return null;
      }
    }
    var str1 =
      "<tr>" +
      "<th>债券代码</th>" +
      '<td id="BOND_CODE"></td>' +
      "+<th>债券简称</th>" +
      '<td id="BOND_ABBR"></td>' +
      "</tr>" +
      "<tr>" +
      '<th><span id="ownerName">发行人</span></th>' +
      '<td id="ISSUE_OWNER"  colspan="3"></td>' +
      "</tr>" +
      '<th>债券扩位简称</th>' +
      '<td id="SECURITY_ABBR_FULL"  colspan="3"></td>' +
      "</tr>" +
      "<tr>" +
      "<th>债券全称</th>" +
      '<td id="BOND_FULL"  colspan="3"></td>' +
      "</tr>" +
      "<tr>" +
      "<th>债券类型</th>" +
      '<td id="BOND_TYPE" colspan="3"></td>' +
      "</tr>" +
      "<tr>" +
      "<th>发行量（亿元）</th>" +
      '<td id="ISSUE_VALUE"></td>' +
      "<th>上交所上市总量</br>（亿元）</th>" +
      '<td id="SSE_TOTAL_AMT"></td>' +
      "</tr>" +
      '<tr style="display:none;" id="issueDay">' +
      "<th>发行起始日</th>" +
      '<td id="ISSUED_START_DAY">-</td>' +
      "<th>发行终止日</th>" +
      '<td id="ISSUED_END_DAY">-</td>' +
      "</tr>" +
      "<tr>" +
      "<th>起息日期</th>" +
      '<td id="START_DATE"></td>' +
      "<th>到期日期</th>" +
      '<td id="END_DATE"></td>' +
      "</tr>" +
      "<tr>" +
      '<th id="LISTING_HEAD">上市日期</th>' +
      '<td id="LISTING_DATE"></td>' +
      "<th>银行间代码</th>" +
      '<td id="BANK_CODE" colspan="3"></td>' +
      "</tr>" +
      "<tr>" +
      "<th>计息方式</th>" +
      '<td id="INTEREST_TYPE"></td>' +
      "<th>付息方式</th>" +
      '<td id="PAY_TYPE"></td>' +
      "</tr>" +
      "<tr>" +
