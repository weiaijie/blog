        BOND_CODE: keyword,
      };

      bondlistT.init(headers);
      downloadParams = utils.mergeJson(params, p);
      bondlistT.getDataByAjax(url, utils.mergeJson(params, p), null, true);
    };

    var downloadParams = params;
    var download = function () {
      var ddUrl =
        destinationHostURI +
        "/commonExcelDd.do?" +
        "sqlId=COMMON_SSE_CP_ZQ_ZQLB_JBXX_C" +
        "&BOND_CODE=" +
        downloadParams.BOND_CODE +
        "&BOND_TYPE=" +
        downloadParams.BOND_TYPE +
        "&" +
        Math.floor(Math.random() * (100000000 + 1));
      window.location.href = ddUrl;
    };

