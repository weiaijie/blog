      utils.compositeInfo({
        info: "总共" + total + "条数据",
        target: "deadling",
      }); //表格右上角显示信息
      utils.dynamicCompositeInfo(bondlistT, {
        target: "deadling",
      }); //表格右上角显示信息
      //发送请求
      defaultRequest();
      $(".search-btn").click(function () {
        goSwitch();
      });
      $(".download-btn").click(function () {
        download();
      });
    });
  }

