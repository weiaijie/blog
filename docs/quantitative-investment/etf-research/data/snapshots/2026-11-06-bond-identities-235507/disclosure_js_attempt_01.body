      var eventTarget;
      if (/msie/.test(navigator.userAgent.toLowerCase())) {
        eventTarget = event.srcElement;
      } else if (/firefox/.test(navigator.userAgent.toLowerCase())) {
        eventTarget = event.target;
      }
      var keyword = $("#keywordsearch").val();

      if (
        keyword == "输入债券代码/简称" ||
        keyword == null ||
        keyword == undefined ||
        keyword == ""
      ) {
        alert("请输入债券代码或简称！");
        return false;
      }
