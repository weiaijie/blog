{
  "schema_version": 1,
  "transport": "curl",
  "address_family": "ipv4",
  "connect_timeout_seconds": 8,
  "total_timeout_seconds": 25,
  "max_attempts": 3,
  "backoff_seconds": [
    2,
    4
  ],
  "max_retry_after_seconds": 30,
  "max_response_bytes": 10485760,
  "policy": "Verified HTTPS over DNS-resolved IPv4; bounded transport retries only. Semantic admission is unchanged."
}
