,\"className\":\"text-muted-foreground hover:text-foreground block rounded-md px-2 py-1\",\"children\":\"数据新鲜度\"}]}],[\"$\",\"li\",\"subscription\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#subscription\",\"className\":\"text-muted-foreground hover:text-foreground block rounded-md px-2 py-1\",\"children\":\"申购状态\"}]}],[\"$\",\"li\",\"data-sources\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#data-sources\",\"className\":\"text-muted-foreground hover:text-foreground block rounded-md px-2 py-1\",\"children\":\"数据来源\"}]}],[\"$\",\"li\",\"disclaimer\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#disclaimer\",\"className\":\"text-muted-foreground hover:text-foreground block rounded-md px-2 py-1\",\"children\":\"免责声明\"}]}],[\"$\",\"li\",\"privacy\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#privacy\",\"className\":\"text-muted-foreground hover:text-foreground block rounded-md px-2 py-1\",\"children\":\"隐私\"}]}]]}]}]}],[\"$\",\"article\",null,{\"className\":\"max-w-3xl space-y-10\",\"children\":[[\"$\",\"header\",null,{\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight\",\"children\":\"方法论与数据说明\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground mt-4 text-base leading-7\",\"children\":\"本页公开本站全部指标的计算方法、字段口径与数据来源。来源不明的数字不应被采信。\"}]]}],[\"$\",\"section\",null,{\"id\":\"data-status\",\"aria-labelledby\":\"data-status-h\",\"className\":\"scroll-mt-24 border-t pt-8\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"data-status-h\",\"className\":\"text-xl font-semibold tracking-tight\",\"children\":\"数据接入进度\"}],[\"$\",\"div\",null,{\"className\":\"text-foreground/90 mt-4 space-y-4 text-[15px] leading-7\",\"children\":[[\"$\",\"p\",null,{\"children\":\"已接入的官方来源：\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc space-y-1 pl-5\",\"children\":[[\"$\",\"li\",null,{\"children\":\"单位净值、基金资料：证监会资本市场电子化信息披露平台（净值每天多轮采集，资料每周一采集）。\"}],[\"$\",\"li\",null,{\"children\":\"场外申购、定投、转换转入的暂停、恢复与限额：同一平台的临时公告及其结构化（XBRL）版本；无结构化版本的公告标记为“待人工核对”，不推断状态。\"}],[\"$\",\"li\",null,{\"children\":\"溢价风险提示与临时停牌：基金公司在同一平台发布的公告。\"}],[\"$\",\"li\",null,{\"children\":\"ETF 一级市场申购、赎回是否允许及单日额度：沪深交易所网站发布的申购赎回清单。\"}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"ETF 行情转载自公开网页，非交易所授权数据。\"}],\"收盘价、成交额与 IOPV 取自腾讯财经的公开行情页面，东方财富批量行情用于核对当日收盘价，历史收盘价由腾讯日线回补。工作日 15:10、15:20、15:35、16:35 分轮采集；仅在来源快照确属当日收盘后才写入当日数据。两个来源的收盘价不一致时标记为“来源冲突”，不参与统计。纳指100、标普500、道琼斯、德国DAX与标普油气勘探生产专题页用 QQQ、SPY、DIA、DAX、XOP（在境外市场上市、跟踪同一指数的 ETF）收盘价作对照，每个工作日 08:00、09:00 独立获取腾讯日线，未复权、不含分红；美国50、日经225、恒生指数、标普生物科技与标普信息科技暂不提供海外对照线。德国DAX对照品为 Nasdaq 上市的 Global X DAX Germany ETF；DAX 指数币种为 EUR，境内基金份额与行情币种为 CNY，对照 ETF 为 USD。XBI 的公开资料对应 `SPSIBIT`，尚未证实与境内标普生物科技基金法律目标的价格指数 `SPSIBI` 是同一回报变体，因此不作为代理对照。标普信息科技没有已核实的同指数海外 ETF，不能用 XLK 代替。来源尚未更新或遇到休市时不会生成新日期的数据。转载数据可能有误或延迟，以交易所和基金管理人公布的数据为准。\"]}],[\"$\",\"p\",null,{\"children\":\"参考净值折溢价（IOPV） = 收盘价 ÷ 同一快照的 IOPV − 1；净值折溢价（NAV） = 收盘价 ÷ 同一估值日的官方单位净值 − 1。QDII 净值通常晚一至两个交易日公布，净值折溢价（NAV）相应滞后；历史交易日无 IOPV，仅有净值折溢价（NAV）。\"}],[\"$\",\"p\",null,{\"children\":\"净值的估值日以数据源为准；数据源未提供公布时间时，页面显示本站首次获取的时间。首次上线时回补的历史公告标注为“回补收录”，其首次发现时间不代表采集时效。\"}]]}]]}],[\"$\",\"section\",null,{\"id\":\"coverage\",\"aria-labelledby\":\"coverage-h\",\"className\":\"scroll-mt-24 border-t pt-8\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"coverage-h\",\"className\":\"text-xl font-semibold tracking-tight\",\"children\":\"收录范围\"}],[\"$\",\"div\",null,{\"className\":\"text-foreground/90 mt-4 space-y-4 text-[15px] leading-7\",\"children\":[\"$L1f\",\"$L20\",\"$L21\"]}]]}],\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\"]}]]}]\n"])</script><script>self.__next_f.push([1,"28:I[63842,[\"$16\",\"$17\",\"$18\",\"$19\"],\"default\"]\n1f:[\"$\",\"p\",null,{\"children\":\"覆盖跟踪纳斯达克100、标普500、MSCI美国50、道琼斯工业平均、日经225、德国DAX、恒生指数与标普生物科技精选行业指数的境内产品：\"}]\n20:[\"$\",\"ul\",null,{\"className\":\"list-disc space-y-1 pl-5\",\"children\":[[\"$\",\"li\",null,{\"children\":\"场内 ETF：在上海、深圳证券交易所上市交易的跨境 ETF。\"}],[\"$\",\"li\",null,{\"children\":\"场内 LOF：已在交易所上市的 QDII-LOF A 类份额；没有 IOPV，不与 ETF 参考折溢价（IOPV）混排。\"}],[\"$\",\"li\",null,{\"children\":\"场外 QDII：境内公募 QDII 基金的各个份额类别（A/C 类、人民币/美元份额分别计）。\"}]]}]\n21:[\"$\",\"p\",null,{\"children\":\"美国50目前只收录 2 只场内 ETF；道琼斯只收录鹏华 513400，不包含跟踪道琼斯石油等其他指数的产品。日经225收录 4 只场内 QDII ETF，以及华安三菱日联日经225ETF发起式联接 A/C 两个场外份额，不包含跟踪东证指数（TOPIX）的 513800。德国DAX收录华安 513030 与嘉实 159561 两只直接 QDII ETF，以及华安国际龙头(DAX)ETF联接 A/C 两个场外份额。恒生指数首批只收录易方达 513210 与华夏 159920 两只独立法律基金的场内 QDII ETF；不收录非 QDII 的 513600、513660、159271，也不混入恒生科技、恒生国企或港股通指数产品。标普生物科技精选行业首批收录嘉实 159502 ETF、易方达 161127 场内 LOF A 人民币与 012866 场外 C 人民币；003720、012867 美元份额暂不收录。标普油气勘探生产只收同一价格指数的 159518、513350 两只 ETF，不混入华宝油气跟踪的全收益上游股票指数份额。标普信息科技只收 161128 场内 LOF A 人民币与 012868 场外 C 人民币，003721、012869 美元份额暂不收录；没有场内 ETF，因此不提供参考折溢价（IOPV）排行或提醒。ETF、LOF 与场外份额按各自口径分开展示，不能混排成同一折溢价结论。未收录的基金在搜索时明确提示“未收录”，不显示为空白数据。\"}]\n"])</script><script>self.__next_f.push([1,"22:[\"$\",\"section\",null,{\"id\":\"formulas\",\"aria-labelledby\":\"formulas-h\",\"className\":\"scroll-mt-24 border-t pt-8\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"formulas-h\",\"className\":\"text-xl font-semibold tracking-tight\",\"children\":\"指标公式\"}],[\"$\",\"div\",null,{\"className\":\"text-foreground/90 mt-4 space-y-4 text-[15px] leading-7\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold\",\"children\":\"参考净值折溢价（IOPV，场内 ETF）\"}],[\"$\",\"p\",null,{\"className\":\"bg-muted num rounded-lg px-4 py-3 font-medium\",\"children\":\"参考净值折溢价（IOPV） = 收盘价 ÷ 收盘 IOPV − 1\"}],[\"$\",\"p\",null,{\"children\":\"仅在价格与 IOPV 属于同一时点且 IOPV 大于 0 时计算。IOPV 为基金管理人按持仓估算的参考净值，并非可保证的赎回价格；参考净值折溢价（IOPV）也不代表可无风险获取的套利收益。\"}],[\"$\",\"h3\",null,{\"className\":\"pt-2 font-semibold\",\"children\":\"净值折溢价（NAV，场内 ETF）\"}],[\"$\",\"p\",null,{\"className\":\"bg-muted num rounded-lg px-4 py-3 font-medium\",\"children\":\"净值折溢价（NAV） = 估值日收盘价 ÷ 估值日单位净值（NAV） − 1\"}],[\"$\",\"p\",null,{\"children\":\"仅使用同一日期的价格与净值。QDII 基金的正式净值通常于估值日后 1–2 个交易日公布，因此净值折溢价（NAV）均对应较早的估值日，页面同时标明估值日；最近一至两天的净值折溢价（NAV）在净值公布前为空。\"}],[\"$\",\"h3\",null,{\"className\":\"flex items-center gap-2 pt-2 font-semibold\",\"children\":[\"估算折溢价（场内 LOF） \",[\"$\",\"span\",null,{\"className\":\"border-warn/30 bg-warn-soft text-warn inline-flex items-center rounded-full border px-1.5 py-0.5 text-[10px] font-semibold tracking-wide\",\"title\":\"LOF 数据仍在开发中，指标口径可能调整\",\"children\":\"Beta\"}]]}],[\"$\",\"p\",null,{\"className\":\"bg-muted num rounded-lg px-4 py-3 font-medium\",\"children\":\"上交易日估算 = 最新收盘价 ÷ 最新已公布单位净值（NAV） − 1\"}],[\"$\",\"p\",null,{\"className\":\"bg-muted num rounded-lg px-4 py-3 font-medium\",\"children\":\"最新估算 = 最新价 ÷ 最新已公布单位净值（NAV） − 1\"}],[\"$\",\"p\",null,{\"children\":\"LOF 没有 IOPV，不计算参考净值折溢价（IOPV）。页面分「上交易日估算」和「最新估算」两列：前者用最近收盘价，后者用交易时段最新价；两者都使用最新已公布净值，并标明净值估值日。最新净值或盘中价未公布时，最新估算显示“基金公司暂未公布”。有同一日官方净值时，优先按净值折溢价（NAV）展示（当日收盘价 ÷ 当日净值）。实际折溢价以基金管理人公布为准。最新估算不是实时保证，不构成投资建议。缺少价格或净值时不展示。历史曲线仍只保留同日价格与同日净值。\"}],[\"$\",\"h3\",null,{\"className\":\"pt-2 font-semibold\",\"children\":\"溢价回落情景\"}],[\"$\",\"p\",null,{\"className\":\"bg-muted num rounded-lg px-4 py-3 font-medium\",\"children\":\"情景收益率 = (1 + 净值变动) × (1 + 目标溢价) ÷ (1 + 当前溢价) − 1\"}],[\"$\",\"p\",null,{\"children\":\"用于说明即使指数净值不变，溢价从当前水平回落也会使 ETF 价格下跌。金额变动 = 投入金额 × 情景收益率。 结果仅为情景测算，不含佣金、买卖价差、冲击成本、跟踪误差、汇率与税费，不是价格预测。\"}],[\"$\",\"h3\",null,{\"className\":\"pt-2 font-semibold\",\"children\":\"同指数位置\"}],[\"$\",\"p\",null,{\"children\":\"按同一指数、同一口径的可比 ETF 计算；1 为最低溢价。停牌、数据过期或缺少 IOPV 的报价不参与排名。 同指数位置只用于比较，不构成买卖建议。\"}],[\"$\",\"h3\",null,{\"className\":\"pt-2 font-semibold\",\"children\":\"隐含溢价金额（成本计算器）\"}],[\"$\",\"p\",null,{\"className\":\"bg-muted num rounded-lg px-4 py-3 font-medium\",\"children\":\"参考净值 = 买入金额 ÷ (1 + 溢价率)；隐含溢价 = 买入金额 − 参考净值\"}],[\"$\",\"p\",null,{\"children\":\"例：买入 100,000 元、参考净值折溢价（IOPV） 12.37%，对应参考净值约 88,991.72 元，隐含溢价约 11,008.28 元。佣金单独列示；买卖价差、跟踪误差、汇率与税费不计入。结果为估算值，并非成交结果或收益预测。\"}],[\"$\",\"h3\",null,{\"className\":\"pt-2 font-semibold\",\"children\":\"场外申购与赎回成本\"}],[\"$\",\"p\",null,{\"className\":\"bg-muted num rounded-lg px-4 py-3 font-medium\",\"children\":\"申购费 = 买入金额 × 适用档费率；赎回费 = 赎回金额 × 持有期档费率\"}],[\"$\",\"p\",null,{\"children\":\"申购费按产品资料概要中的单笔金额档位计算，赎回费按持有天数档位计算。销售服务费为年费率，按日从基金资产中计提， 不计入申购时的一次性费用。\"}],[\"$\",\"p\",null,{\"children\":\"计算器假设赎回时市值等于买入金额，不含净值涨跌、汇率、税费与销售机构折扣；结果仅为费用估算，不构成收益预测。\"}],[\"$\",\"h3\",null,{\"className\":\"pt-2 font-semibold\",\"children\":\"溢价分级\"}],[\"$\",\"p\",null,{\"children\":[\"参考净值折溢价（IOPV） ≥ \",10,\"% 标为“高溢价”，≥ \",5,\"% 标为“偏高”，小于 0 标为“折价”。分级仅作提示，不构成买卖信号。\"]}],[\"$\",\"h3\",null,{\"className\":\"pt-2 font-semibold\",\"children\":\"历史分位\"}],[\"$\",\"p\",null,{\"children\":\"仅在同一口径的有效样本不少于 60 个交易日时显示。停牌、IOPV 缺失的日期不计入样本，也不补零；图表在缺失处断开。\"}],[\"$\",\"h3\",null,{\"className\":\"pt-2 font-semibold\",\"children\":\"同指数溢价中位数\"}],[\"$\",\"p\",null,{\"children\":\"每个交易日取同一指数下所有有效场内 ETF 的收盘参考折溢价（IOPV）中位数，并给出当日样本数。\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"23:[\"$\",\"section\",null,{\"id\":\"freshness\",\"aria-labelledby\":\"freshness-h\",\"className\":\"scroll-mt-24 border-t pt-8\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"freshness-h\",\"className\":\"text-xl font-semibold tracking-tight\",\"children\":\"数据新鲜度\"}],[\"$\",\"div\",null,{\"className\":\"text-foreground/90 mt-4 space-y-4 text-[15px] leading-7\",\"children\":[[\"$\",\"p\",null,{\"children\":\"每项数据均附带时间与新鲜度状态。数据过期时明确标注，不将旧值作为最新值展示。\"}],[\"$\",\"p\",null,{\"children\":\"每条公告与状态变更同时记录公告时间、生效时间和本站首次发现时间。首次发现较公告晚 12 小时以上时，变更记录中予以标注，因为其间本站显示的状态可能已过时。\"}],[\"$\",\"p\",null,{\"children\":\"对比页的分享链接可附带分享时的数据日期（snapshot=YYYY-MM-DD）。接收者打开时，页面会提示该日期与当前数据日期是否一致，但展示的始终是当前数据。\"}],[\"$\",\"p\",null,{\"children\":\"指数专题分享图是生成时的数据快照：最高与最低只在同一指数、同一溢价口径和同一日期的有效场内 ETF 中比较， 不足两只时只显示指数概览。图片标注数据更新与生成时间，二维码打开的指数页可能已有新数据；演示模式图片会明确标注数值虚构。\"}],[\"$\",\"dl\",null,{\"className\":\"divide-y rounded-lg border\",\"children\":[[\"$\",\"div\",\"fresh\",{\"className\":\"grid grid-cols-[7rem_1fr] items-center gap-4 px-4 py-3\",\"children\":[[\"$\",\"dt\",null,{\"children\":[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1 text-xs font-medium whitespace-nowrap te