
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
<title>汇率</title>
<meta name="description" content="">
<meta name="keywords" content="">
<link href="./lib/datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet">
<script type="text/javascript" src="./lib/huilan-jquery-ui.js?self=true&skin=default"></script>
<script type="text/javascript" src="./lib/datetimepicker/jquery.datetimepicker.full.min.js"></script>
<script type="text/javascript" src="./lib/echars.min.js"></script>
<style type="text/css">
	.search-bar {
		padding: 10px;
		text-align: center;
	}
	.search-bar input {
		height: 20px;
		line-height: 20px;
	}
	#result {
		margin: 10px 0;
		font-size: 16px;
		display: none;
	}
	#main {
		width: 100%;
		height: 450px;
	}
	#table{
		height: 450px;
		overflow: auto;
		display: none;
	}
	#table table {
		width: 100%;
		border-collapse: collapse;
		border: 1px solid #333333;
	}
	#table table th,#table table td {
		line-height: 24px;
		text-align: center;
		border: 1px solid #333333;
	}
</style>
</head>
<body>
	<div class="search-bar">
		选择日期：<input type="text" id="datepicker"> 
		<button type="button" id="search">查询</button>
		<button type="button" id="change">切换到表</button>
		<p id="result"></p>
	</div>
	
	<div id="main"></div>
	<div id="table">
		<table>
			<tr>
				<th>日期</th>
				<th>汇率</th>
			</tr>
		</table>
	</div>
	<script type="text/javascript">
		var dataUrl='/huilv/flex-xml/flex_xml_1.xml'
	</script>
	<script type="text/javascript" src="./main.js"></script>
</body>
</html>
