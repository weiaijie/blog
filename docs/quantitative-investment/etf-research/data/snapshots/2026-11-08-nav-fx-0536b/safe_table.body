			<script type="text/javascript"  src="/AppStructured/res/js/datepicker/WdatePicker.js"/></script>
<script type="text/javascript">

function validate() {

		//var currencyId = document.getElementById("currencyId").value;
		var startDateId = document.getElementById("startDateId").value;
		var endDateId = document.getElementById("endDateId").value;
		//document.cookie="xs=true";
		

		//if(currencyId==''){
		//	alert("币种 不能为空,请选择!");
		///	return false;
		//}
		//	if(startDateId==''){
		//		alert("开始日期 不能为空,请选择!");
		//		return false;
		//	}
		//	if(endDateId==''){
		//		alert("结束日期 不能为空,请选择!");
		//		return false;
	//		}
		if(startDateId==""){
			alert("开始日期不能为空!");
			return false;
		}
		if(endDateId==""){
			alert("结束日期不能为空!");
			return false;
		}
		if(daysBetween(endDateId,startDateId) < 0){
			alert("结束日期 不能小于 开始日期,请重新选择!");
			return false;
		}else if(daysBetween(endDateId,startDateId) > 366){
			alert("查询间隔不能超过366天，请重新选择!");
			return false;
		}
	  document.RMBQuery.action="/AppStructured/hlw/RMBQuery.do";
      document.RMBQuery.submit();
	}
	function tijiao()
	{
	  document.RMBQuery.action="/AppStructured/hlw/exportRMBExcel.do";
      document.RMBQuery.submit();
	}
	
	//| 求两个时间的天数差 日期格式为 YYYY-MM-dd   
function daysBetween(DateOne,DateTwo) 
{  

    var OneMonth = DateOne.substring(5,DateOne.lastIndexOf ('-')); 
    var OneDay = DateOne.substring(DateOne.length,DateOne.lastIndexOf ('-')+1); 
    var OneYear = DateOne.substring(0,DateOne.indexOf ('-')); 

    var TwoMonth = DateTwo.substring(5,DateTwo.lastIndexOf ('-')); 
    var TwoDay = DateTwo.substring(DateTwo.length,DateTwo.lastIndexOf ('-')+1); 
    var TwoYear = DateTwo.substring(0,DateTwo.indexOf ('-')); 

    var cha=((Date.parse(OneMonth+'/'+OneDay+'/'+OneYear)- Date.parse(TwoMonth+'/'+TwoDay+'/'+TwoYear))/86400000);   
    return cha;
}

</script>

