<script type="text/javascript">
	window.onload = function() {
		let totalPage = '37';
		let currentPage = '13';
		let next = document.querySelector("#next");
		if (totalPage == currentPage) {
			next.style.cursor = "no-drop";
			next.style.opacity = 0.5;
		} else {
			next.style.cursor = "pointer";
			next.style.opacity = 1;
		}
		let prev = document.querySelector("#prev");
		if (currentPage == 1) {
			prev.style.cursor = "no-drop";
			prev.style.opacity = 0.5;
		} else {
			prev.style.cursor = "pointer";
			prev.style.opacity = 1;
		}
	}
</script>
<script type="text/javascript">
	function queryFormSubmitForFirstPage(){
		$('#isQuery').val("true");
		$('#queryForm').submit();
	}

	//下一页
	function nextPage(){
		let totalPage = '37';
		let currentPage = '13';
		if (totalPage != currentPage) {
			var hidden = "<input type='hidden' name='pageIndex' value='14' />";
			$("#queryForm").append(hidden).submit();
		}
	}

	//上一页
	function upPage(){
		let currentPage = '13';
		if (currentPage != 1) {
			var hidden = "<input type='hidden' name='pageIndex' value='12' />";
			$("#queryForm").append(hidden).submit();
		}
	}


	//点击当前页
	function goPage(){
		var goNum=$("#goNum").val();
		let totalPage = '37';
		if (Number(goNum) > Number(totalPage)) {
			return;
		}
		var hidden = "<input type='hidden' name='pageIndex' value='"+goNum+"' />";
		$("#queryForm").append(hidden).submit();
	}

	//点击当前页
	function thisPage(num){
		var hidden = "<input type='hidden' name='pageIndex' value='"+num+"' />";
		$("#queryForm").append(hidden).submit();
	}

	function queryFormSubmitForFirstPage(){
		$('#isQuery').val("true");
		$('#queryForm').submit();
	}

	$(function() {
		var date1 = laydate.render({
			elem: '#date1',
			done: function(value, date) {
				$("#beginDate").val(value);
				$('#date1').removeClass('placeholder');
				date2.config.min = {
					year: date.year,
					month: date.month - 1,
					date: date.date,
					hours: date.hours,
					minutes: date.minutes,
					seconds: date.seconds
				};
			}
		});

		var date2 = laydate.render({
			elem: '#date2',
			done: function(value, date) {
				$("#endDate").val(value);
				$('#date2').removeClass('placeholder');
				date1.config.max = {
					year: date.year,
					month: date.month - 1,
					date: date.date,
					hours: date.hours,
					minutes: date.minutes,
					seconds: date.seconds
				};
			}
		});
		var endDate="2026-10-30";
		var beginDate="2023-10-30";
		if(beginDate!=null && beginDate!=""){
			$("#date1").text(beginDate);
		}

		if(endDate!=null && endDate!=""){
			$("#date2").text(endDate);
		}


	});


