# Preserve original response and manifest bytes across Windows/Linux checkouts.
data/snapshots/** -text whitespace=cr-at-eol

# Sealed daily bundles keep exact bytes; matplotlib SVG whitespace is evidence.
reports/daily/** -text
reports/daily/*/site/risk.html -whitespace
reports/operations/** -text
reports/health/** -text
reports/notice-reviews/** -text
reports/notice-decisions/** -text

# HTTP headers preserve server spacing and the terminating blank line.
data/snapshots/**/*.headers -whitespace
